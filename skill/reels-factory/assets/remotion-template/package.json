{
  "name": "reels-factory-studio",
  "version": "3.1.0",
  "description": "Codex-first фабрика вертикальных Reels с локальным монтажом, динамическим кадрированием и QC",
  "repository": {},
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "@remotion/bundler": "4.0.519",
    "@remotion/captions": "4.0.519",
    "@remotion/cli": "4.0.519",
    "@remotion/install-whisper-cpp": "4.0.519",
    "@remotion/layout-utils": "4.0.519",
    "@remotion/media": "4.0.519",
    "@remotion/renderer": "4.0.519",
    "@remotion/tailwind-v4": "4.0.519",
    "@remotion/zod-types": "4.0.519",
    "mediabunny": "1.55.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.519",
    "tailwindcss": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.519",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render",
    "render:reel": "remotion render ReelsUnderKey out/reel-ready.mp4 --codec=h264 --crf=18 --concurrency=1",
    "still:reel": "remotion still ReelsUnderKey out/reel-preview.png --frame=45",
    "prepare:media": "node tools/prepare-reel.mjs",
    "captions:import": "node tools/import-captions.mjs",
    "captions:generate": "node tools/transcribe-reel.mjs",
    "runtime:ensure": "node tools/ensure-whisper.mjs",
    "qc": "node tools/qc-report.mjs",
    "media:register": "node tools/register-media.mjs",
    "provider:fal": "node tools/generate-fal-media.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
